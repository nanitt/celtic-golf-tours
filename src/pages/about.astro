---
import { images, imageUrl } from '../data/images';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HeritageWall from '../components/HeritageWall.astro';
import CelticDivider from '../components/CelticDivider.astro';
import TexturedSection from '../components/TexturedSection.astro';
import { stats, showStat, hasStats, operator } from '../data/site';

const numbers = [
  { value: stats.happyGolfers, label: 'Happy Golfers', accent: 'text-champagne' },
  { value: stats.averageRating, label: 'Average Rating', accent: 'text-brass' },
  { value: stats.toursDelivered, label: 'Tours Delivered', accent: 'text-champagne' },
  { value: stats.yearsExperience, label: "Years' Experience", accent: 'text-champagne' }
].filter(n => showStat(n.value));
---

<Layout title="About Celtic Golf Tours" description="Learn about Celtic Golf Tours and Centre Holidays, the licensed Ontario travel operator behind golf trips across Scotland and Ireland.">
  <!-- TODO: Replace placeholder - Unsplash hero image with real CGT team, facility, or tour photography. -->
  <Hero
    title="About Celtic Golf Tours"
    subtitle="Golf trips shaped around your group and the way you want to travel"
    backgroundImage={imageUrl(images.aboutHero, 1800, 80)}
    size="large"
    ctaText=""
  />

  <!-- Our Story Section -->
  <!-- TODO: Replace placeholder - generic origin story, first-hand course claims, and Unsplash supporting image need real CGT history and photography. -->
  <section class="section-padding bg-white">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div>
          <p class="section-kicker mb-4">Our Story</p>
          <h2 class="font-heading text-section mb-8" style="font-size: clamp(2rem, 4vw, var(--text-section));">Born From a Love of the Game</h2>
          <p class="text-text leading-relaxed mb-6">
            Celtic Golf Tours is the golf arm of {operator.name}, a licensed {operator.region}
            travel operator. That is the important part: your trip is arranged through
            a registered operator, with a clear place to start planning.
          </p>

          <!-- Pulled blockquote -->
          <blockquote class="border-l-4 border-brass pl-6 my-8">
            <p class="font-heading-display text-2xl text-charcoal leading-snug" style="font-weight: 400;">
              Your trip starts with your group.
            </p>
          </blockquote>

          <p class="text-text leading-relaxed mb-6">
            Tell us what matters to your group — the kind of courses, the pace of the week,
            the places you want to stay and the dates you are considering. We will help you
            turn that into a practical route.
          </p>
          <p class="text-text leading-relaxed">
            Whether this is your first links trip or a return to Scotland and Ireland,
            the conversation starts in the same place: what would make the week work for you?
          </p>
        </div>
        <div class="group relative aspect-[4/3] overflow-hidden">
          <div
            class="absolute inset-0 bg-cover bg-center scale-on-hover"
            style={`background-image: url('${imageUrl(images.aboutStory, 800, 80)}')`}
          ></div>
          <div class="absolute inset-0 overlay-default overlay-hover transition-premium"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section — Asymmetric Editorial -->
  <!-- TODO: Replace placeholder - claims about played courses, course relationships, and group caps need verified CGT policy/proof. -->
  <TexturedSection texture="pressed-paper" background="stone">
    <div class="content-wide px-6 lg:px-12">
      <div class="space-y-20 lg:space-y-28">
        <!-- Differentiator 1 -->
        <div data-reveal="fade-up">
          <p class="section-kicker mb-4">What Sets Us Apart</p>
          <h3 class="font-heading-display text-3xl lg:text-4xl text-charcoal mb-6 max-w-2xl" style="font-weight: 300;">Start with the right questions.</h3>
          <p class="text-text leading-relaxed max-w-xl">
            The best starting point is not a fixed package. It is your group, the time you have,
            and the sort of trip you want to take.
          </p>
        </div>

        <!-- Differentiator 2 -->
        <div class="max-w-lg ml-auto" data-reveal="fade-up">
          <div class="w-16 h-px bg-brass mb-6"></div>
          <h3 class="font-heading text-2xl lg:text-3xl text-charcoal mb-6">A route with room to breathe.</h3>
          <p class="text-text leading-relaxed">
            A good golf week has enough time between rounds to travel, settle in and enjoy the
            places around the course. That is the rhythm we discuss before anything is confirmed.
          </p>
        </div>

        <!-- Differentiator 3 -->
        <div data-reveal="fade-up">
          <div class="flex items-center gap-4 mb-6">
            <span class="w-2.5 h-2.5 bg-brass rotate-45 flex-shrink-0"></span>
            <div class="w-12 h-px bg-brass/50"></div>
          </div>
          <h3 class="font-heading text-2xl lg:text-3xl text-charcoal mb-6">One clear next step.</h3>
          <p class="text-text leading-relaxed max-w-xl">
            Choose a Buddy Trip with friends or a Concierge Trip shaped around your group.
            If neither is clear yet, a short conversation is enough to work out where to begin.
          </p>
        </div>
      </div>
    </div>
  </TexturedSection>

  <!-- By the Numbers — hidden until Terry confirms the figures (see tasks/content-needed.md) -->
  {hasStats() && (
    <section class="py-16 bg-celtic-dark">
      <div class="content-wide px-6 lg:px-12">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          {numbers.map((stat, i) => (
            <div data-reveal="fade-up" data-reveal-delay={i + 1}>
              <p class={`font-heading-display text-4xl lg:text-5xl ${stat.accent}`} style="font-weight: 300;">{stat.value}</p>
              <p class="section-kicker-light mt-2">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Heritage Wall -->
  <!-- TODO: Replace placeholder - HeritageWall uses stock imagery/captions; replace with CGT/course-owned or licensed historical assets. -->
  <HeritageWall />

  <!--
    The operator relationship.

    This section used to name "Celtic Golf Centre" as the parent company. That
    is not the licensed operator — Centre Holidays is, and Terry's requirement
    is that the operator name is on every page. If Celtic Golf Centre is a real
    separate entity he wants credited, it needs its own copy from him; it should
    not stand in for the operator. See tasks/content-needed.md.

    TODO: Terry to supply the Centre Holidays relationship in his own words, and
    approved photography for this slot.
  -->
  <section class="section-padding bg-white">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="lg:order-2">
          <p class="section-kicker mb-4">Our Heritage</p>
          <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">Who you are actually booking with</h2>
          <!-- Brass diamond divider -->
          <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-0.5 bg-brass"></div>
            <div class="w-1.5 h-1.5 bg-brass rotate-45"></div>
          </div>
          <p class="text-text leading-relaxed mb-6">
            Celtic Golf Tours is the name on the trip. <a href={operator.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-charcoal">{operator.name}</a>
            is the licensed {operator.region} travel operator behind it, and we are a member of IAGTO.
          </p>
          <p class="text-text leading-relaxed mb-6">
            That matters more than it sounds. It means there is a regulated operator
            standing behind your booking, not a website and a hopeful invoice.
          </p>
          <p class="text-text leading-relaxed">
            What you get on top of that is the part we care about: someone who knows
            these coasts, who will tell you when an idea is a bad one, and who picks
            up the phone while you are over there.
          </p>
        </div>
        <div class="lg:order-1 group relative aspect-[4/3] overflow-hidden">
          <div
            class="absolute inset-0 bg-cover bg-center scale-on-hover"
            style={`background-image: url('${imageUrl(images.aboutCentre, 800, 80)}')`}
          ></div>
          <div class="absolute inset-0 overlay-default overlay-hover transition-premium"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-celtic-dark">
    <div class="content-narrow px-6 lg:px-12 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-6">
        Let's Plan Your Adventure
      </h2>
      <p class="text-white/70 text-lg mb-10 max-w-xl mx-auto">
        Ready to experience golf the way it should be? Get in touch and let's start planning.
      </p>
      <a
        href="/contact"
        class="btn-primary btn-lg btn-primary-inverted"
      >
        Contact Us
        <svg aria-hidden="true" class="arrow w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
