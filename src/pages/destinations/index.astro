---
import { images, imageUrl } from '../../data/images';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import TexturedSection from '../../components/TexturedSection.astro';
import CelticDivider from '../../components/CelticDivider.astro';
import { activeDestinations, destinationHref } from '../../data/destinations';

const destinations = activeDestinations.map(d => ({
  ...d,
  href: destinationHref(d),
  imageSrc: imageUrl(images[d.image], 1200, 80),
}));
---

<Layout title="Destinations" description="Explore our luxury golf tour destinations across Scotland and Ireland.">
  <!-- TODO: Replace placeholder - Unsplash hero image with real CGT destination/course photography. -->
  <Hero
    title="Destinations"
    subtitle="Two nations. Countless legendary courses. One unforgettable journey."
    backgroundImage={imageUrl(images.destinationsHero, 1800, 80)}
    size="large"
    ctaText=""
  />

  <!-- Interactive Map Section -->
  <!-- TODO: Replace placeholder - map course callouts need verified CGT destination/course inventory and real popup assets. -->
  <TexturedSection texture="topo" background="cream" padding="section">
    <div class="content-wide px-6 lg:px-12">
      <div class="text-center mb-12">
        <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">Discover Your Destination</h2>
        <CelticDivider variant="simple" color="brass" width="narrow" class="my-6" />
        <p class="text-text max-w-2xl mx-auto">Explore the legendary golf regions of the British Isles. Hover over a region to see signature courses.</p>
      </div>
      <InteractiveMap enableAudio={false} />
    </div>
  </TexturedSection>

  <!-- Destinations Grid -->
  <!-- TODO: Replace placeholder - grid imagery is stock; slots are scotlandHero / irelandHero in src/data/images.ts. -->
  <section class="section-padding bg-white">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {destinations.map((dest) => (
          <a href={dest.href} class="group block">
            <div class="relative aspect-[16/10] overflow-hidden mb-6">
              <div
                class="absolute inset-0 bg-cover bg-center scale-on-hover"
                style={`background-image: url('${dest.imageSrc}')`}
              >
              </div>
              <div class="absolute inset-0 overlay-default overlay-hover transition-premium"></div>
            </div>
            <h2 class="font-heading text-2xl lg:text-3xl text-charcoal mb-2">{dest.name}</h2>
            <p class="text-brass text-sm font-medium mb-3">{dest.tagline}</p>
            <p class="text-text leading-relaxed mb-4">{dest.standfirst}</p>
            <!--
              Region names, not course names. Where CGT operates is confirmed;
              which courses it can secure is not. See src/data/destinations.ts.
            -->
            <p class="text-text-muted text-xs tracking-[0.15em] uppercase">
              {dest.subRegions.map(s => s.name).join(' · ')}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!--
    Why Travel With Us.

    This section used to claim "guaranteed tee times at even the most exclusive
    venues" and "we've played every course we recommend" — both unverified, and
    both the class of claim tasks/codex-handoff.md rules out. Replaced with
    three things that are true today: where we go, how we sell, and when you
    need to call.
  -->
  <section class="section-padding bg-stone">
    <div class="content-narrow px-6 lg:px-12">
      <div class="text-center mb-16">
        <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">Why Travel With Us</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        <div class="text-center">
          <h3 class="font-heading text-xl mb-4">Regions, Not Checklists</h3>
          <p class="text-text leading-relaxed">
            We build trips around the coasts where the golf is worth the airfare — not the handful of names everyone else quotes on.
          </p>
        </div>
        <div class="text-center">
          <h3 class="font-heading text-xl mb-4">A Conversation, Not a Cart</h3>
          <p class="text-text leading-relaxed">
            There is no booking engine here. You tell us what you want out of the week, and we build it around that.
          </p>
        </div>
        <div class="text-center">
          <h3 class="font-heading text-xl mb-4">Eighteen Months Ahead</h3>
          <p class="text-text leading-relaxed">
            The best tee times are spoken for a year and a half out. Starting early is the whole advantage — so start with a call.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <!-- TODO: Replace placeholder - Unsplash CTA background and recommendation copy need real CGT destination planning copy. -->
  <section class="group relative py-40 lg:py-48 overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center scale-on-hover"
      style={`background-image: url('${imageUrl(images.destinationsCta, 1800, 80)}')`}
    >
    </div>
    <div class="absolute inset-0 overlay-default overlay-hover transition-premium"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white mb-8">
        Not Sure Where to Start?
      </h2>
      <p class="text-white/80 text-lg mb-12 max-w-xl mx-auto">
        Let us help you choose the perfect destination based on your preferences and bucket list.
      </p>
      <a
        href="/contact"
        class="btn-primary btn-lg btn-primary-inverted"
      >
        Get Recommendations
      </a>
    </div>
  </section>
</Layout>
