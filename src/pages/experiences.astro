---
import { images, imageUrl } from '../data/images';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HostedExperienceCard from '../components/HostedExperienceCard.astro';
import { getAllExperiences, getUpcomingExperiences } from '../data/sanity-experiences';

import { tripTypes, tripTypeHref, PLANNING_NOTE } from '../data/trip-types';

const tripTypeCards = tripTypes.map((t) => ({
  ...t,
  href: tripTypeHref(t),
  imageSrc: imageUrl(images[t.image], 900, 80),
}));

const inclusions = [
  { title: 'Somewhere Good to Sleep', description: 'Hotels chosen for the drive to the next first tee, not the brochure' },
  { title: 'All Transfers', description: 'Airport pickups and transport throughout, so nobody is the designated driver' },
  { title: 'One Point of Contact', description: 'The same person from the first call to the flight home' },
  { title: 'Support While You Are There', description: 'Someone reachable if a plan needs changing mid-trip' }
];

const hostedExperiences = await getAllExperiences();
const upcomingExperiences = await getUpcomingExperiences();

const faqs = [
  {
    q: "What's included in a hosted experience?",
    // "Guaranteed tee times at every course" was an access claim CGT has not
    // confirmed — the same one removed from the homepage and /destinations.
    a: "Hosted experiences include accommodation, transfers throughout, a Celtic Golf Tours host for the duration, and someone reachable while you are away. Tee times are arranged as part of the itinerary and confirmed with you before you commit. Flights are not included."
  },
  {
    q: "How far ahead should I book?",
    // Terry's number, and the reason the call happens now rather than later.
    // This answer used to say 6-12 months, which contradicted it.
    a: "Further ahead than most people expect. The popular weeks are held around 18 months out, so if a particular season matters to you, the conversation needs to happen well before the year it falls in. Shorter notice is sometimes possible — it just narrows what we can put together."
  },
  {
    q: "What's the typical group size?",
    a: "Buddy Trips are usually four to sixteen friends travelling together. Concierge Trips have no fixed size — we have run them for two people and for twenty. Hosted departures are kept deliberately small so they do not feel like a package tour."
  },
  {
    q: "Do I need to be a low handicap to join?",
    a: "Not at all. Our hosted experiences welcome golfers of all abilities. Some courses require a handicap certificate for booking purposes — we'll let you know which ones apply to your itinerary and help you arrange documentation."
  },
  {
    q: "What standard of accommodation can I expect?",
    a: "We choose hotels for where they put you the next morning rather than for the star rating, and we will tell you honestly what each one is like. If a property matters to you more than the drive, say so and we will build around that instead."
  },
  {
    q: "Can I customise a hosted experience?",
    a: "Hosted experiences have a set itinerary and departure date. If you want your own courses, dates and pace, that is a <a href='/trips/concierge' class='underline hover:text-charcoal'>Concierge Trip</a> — built from scratch around your group. Get in touch and we will start there."
  },
  {
    q: "What is your cancellation policy?",
    // Deliberately defers to /terms rather than restating the policy. The previous
    // answer ("deposits are non-refundable") directly contradicted the Terms page,
    // which promises a full refund at 90+ days. Keep one source of truth.
    a: "Our full cancellation terms are set out on our <a href='/terms' class='underline hover:text-charcoal'>Terms &amp; Conditions</a> page, and we'll walk you through exactly how they apply to your trip before you commit. We also strongly recommend travel insurance."
  }
];
---

<Layout title="Experiences" description="Discover our range of luxury golf experiences - from bespoke custom tours to hosted trips and corporate events.">
  <!-- TODO: Replace placeholder - Unsplash hero image and broad experience copy need real CGT offering photography/copy. -->
  <Hero
    title="Extraordinary Golf Experiences"
    subtitle="From intimate custom tours to our signature hosted journeys, discover the perfect way to experience the world's finest courses"
    backgroundImage={imageUrl(images.experiencesHero, 1800, 80)}
    size="large"
    ctaText=""
  />

  <!-- Hosted Experiences Section (Featured) -->
  <!-- TODO: Replace placeholder - hosted experiences can fall back to sample trips with invented dates, hosts, prices, availability, highlights, and Unsplash images. -->
  <section class="section-padding bg-white">
    <div class="content-wide px-6 lg:px-12">
      <div class="text-center mb-16">
        {hostedExperiences.length > 0 && <p class="section-kicker mb-4">Limited Availability</p>}
        <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">Hosted Experiences</h2>
        <p class="text-text max-w-2xl mx-auto">
          Our signature bucket-list trips led by the Celtic Golf Tours team. Carefully crafted journeys to extraordinary destinations with exclusive access and unforgettable moments.
        </p>
      </div>

      {hostedExperiences.length > 0 ? (
        <div class="space-y-8">
          {hostedExperiences.map((experience, index) => (
            <HostedExperienceCard experience={experience} featured={index === 0} />
          ))}
        </div>
      ) : (
        <div class="max-w-2xl mx-auto text-center border-t border-charcoal/10 pt-12">
          <p class="font-heading-display text-2xl lg:text-3xl text-charcoal" style="font-weight: 300;">
            Our next season of hosted departures is being finalised.
          </p>
          <p class="text-text mt-4">
            Tell us the dates you have in mind and we'll hold you a place as soon as
            the itineraries are confirmed.
          </p>
          <div class="mt-8">
            <a href="/contact" class="btn-primary btn-md">Register your interest</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!--
    Ways to travel.

    Was Custom Tours / Small Group / Corporate Events — a menu describing the
    company. Terry replaced it with the two things a customer actually picks
    between. Detail lives on /trips/*; this is the fork.
  -->
  <section class="section-padding bg-stone">
    <div class="content-wide px-6 lg:px-12">
      <div class="text-center mb-16">
        <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">Ways to Travel</h2>
      </div>

      <div class="space-y-24 lg:space-y-32">
        {tripTypeCards.map((trip, index) => (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
              <p class="section-kicker mb-4">{trip.kicker}</p>
              <h3 class="font-heading text-3xl md:text-4xl mb-6">{trip.name}</h3>
              <p class="font-heading-display text-xl lg:text-2xl text-charcoal leading-snug mb-6" style="font-weight: 300;">
                {trip.promise}
              </p>
              <p class="text-text leading-relaxed mb-10">{trip.forWho}</p>
              <a href={trip.href} class="btn-primary btn-md">
                About {trip.name}
              </a>
            </div>
            <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="group relative aspect-[4/3] overflow-hidden">
                <div
                  class="absolute inset-0 bg-cover bg-center scale-on-hover"
                  style={`background-image: url('${trip.imageSrc}')`}
                ></div>
                <div class="absolute inset-0 overlay-default overlay-hover transition-premium"></div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Terry: the planning window is why the call happens now, not later. -->
      <p class="text-text-muted text-sm leading-relaxed mt-20 max-w-2xl mx-auto text-center">
        {PLANNING_NOTE}
      </p>
    </div>
  </section>

  <!-- What's Included Section -->
  <!-- TODO: Terry to confirm the real inclusions list and package terms. -->
  <section class="section-padding bg-white">
    <div class="content-narrow px-6 lg:px-12">
      <div class="text-center mb-16">
        <h2 class="font-heading text-section mb-4" style="font-size: clamp(2rem, 4vw, var(--text-section));">What's Included</h2>
        <p class="text-text max-w-xl mx-auto">
          On every trip, whichever way you travel
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
        {inclusions.map((item) => (
          <div class="text-center">
            <h3 class="font-heading text-xl mb-3">{item.title}</h3>
            <p class="text-text text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <!-- TODO: Replace placeholder - FAQ answers include operational, accommodation, booking, and cancellation claims that need real CGT policy details. -->
  <section class="section-padding bg-cream">
    <div class="content-narrow px-6 lg:px-12">
      <div class="mb-12" data-reveal="fade-up">
        <p class="section-kicker mb-4">Common Questions</p>
        <h2 class="font-heading text-charcoal" style="font-size: clamp(2rem, 4vw, var(--text-section));">Before you get in touch</h2>
      </div>

      <div class="divide-y divide-charcoal/10" data-reveal="fade-up" data-reveal-delay="2">
        {faqs.map((item) => (
          <details class="group py-6">
            <summary class="flex items-center justify-between gap-4 list-none cursor-pointer">
              <h3 class="font-heading text-lg text-charcoal group-open:text-celtic transition-colors">{item.q}</h3>
              <span class="flex-shrink-0 w-5 h-5 text-brass">
                <svg aria-hidden="true" class="group-open:rotate-45 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            {/* set:html because answers may contain links (e.g. to /terms). Content is
                authored in this file only — never user input. */}
            <p class="text-text leading-relaxed mt-4 max-w-2xl" set:html={item.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-celtic-dark">
    <div class="content-narrow px-6 lg:px-12 text-center">
      <h2 class="font-heading-display text-3xl md:text-4xl text-white mb-6" style="font-weight: 300;">
        Ready to start planning?
      </h2>
      <p class="text-white/60 text-lg mb-10 max-w-xl mx-auto">
        Tell us about your dream golf trip and we'll build a personalised proposal.
      </p>
      <a
        href="/contact"
        class="btn-primary btn-lg btn-primary-inverted"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
