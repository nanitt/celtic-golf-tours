---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Testimonials" description="Read what our guests say about their Celtic Golf Tours experiences.">
  <!-- TODO: Replace placeholder - Unsplash hero image with real guest/tour photography. -->
  <Hero
    title="Guest Testimonials"
    subtitle="Hear from golfers who've experienced the Celtic Golf Tours difference"
    backgroundImage="https://images.unsplash.com/photo-1693163537665-b7c5a5f01f75?ixlib=rb-4.0.3&auto=format&fit=crop&w=1800&q=80"
    size="large"
    ctaText=""
  />

  <!-- Coming soon placeholder -->
  <!-- TODO: Replace placeholder - add real guest testimonials when available or adjust page claims until testimonials exist. -->
  <section class="section-padding bg-white">
    <div class="content-wide px-6 lg:px-12 text-center">
      <p class="font-heading-display text-2xl lg:text-3xl text-charcoal" style="font-weight: 300; max-width: 44rem; margin: 0 auto;">
        We're collecting stories from our first tours. Check back soon for experiences straight from the fairway.
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <!-- TODO: Replace placeholder - "hundreds of golfers" claim conflicts with first-tours message and needs verified testimonial/customer count. -->
  <section class="section-padding bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <h2 class="font-heading text-section mb-6" style="font-size: clamp(2rem, 4vw, var(--text-section));">
        Ready to Create Your Own Story?
      </h2>
      <p class="text-text text-lg mb-10 max-w-xl mx-auto">
        Join the hundreds of golfers who've experienced the Celtic Golf Tours difference.
      </p>
      <a
        href="/contact"
        class="btn-primary btn-lg"
      >
        Start Planning Your Tour
      </a>
    </div>
  </section>
</Layout>
