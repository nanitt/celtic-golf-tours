---
/**
 * Shared template for a country page.
 *
 * Takes a slug and reads everything else from the data layer, so the country
 * pages hold no content of their own. They used to carry hand-written course
 * lists that drifted from src/data/map-regions.ts.
 *
 * Structure follows Terry's direction: photography first, few words. Each
 * region is one image band, one line about the place, and a plain list of the
 * courses in it — never a sentence promising access to them.
 */
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import { images, imageUrl } from '../data/images';
import { destinations } from '../data/destinations';
import { mapRegions } from '../data/map-regions';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const destination = destinations.find((d) => d.slug === slug);
if (!destination) {
  throw new Error(`DestinationPage: no destination with slug "${slug}" in destinations.ts`);
}

const { name, tagline, standfirst, subRegions } = destination;

// Courses come from map-regions so the map and the page cannot disagree.
const coursesFor = (subRegionId: string) =>
  mapRegions
    .flatMap((r) => r.courses)
    .filter((c) => c.subRegionId === subRegionId);

const regions = subRegions.map((sub) => ({
  ...sub,
  imageSrc: imageUrl(images[sub.image], 1600, 80),
  courses: coursesFor(sub.id),
}));
---

<Layout title={name} description={`Luxury golf tours in ${name}. ${tagline}`}>
  <Hero
    title={`Golf in ${name}`}
    subtitle={tagline}
    backgroundImage={imageUrl(images[destination.image], 1800, 80)}
    size="medium"
    ctaText="Plan Your Tour"
    ctaLink="/contact"
  />

  <!-- Overview -->
  <section class="section-padding bg-cream">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div data-reveal="fade-up">
          <p class="section-kicker mb-6">{name}</p>
          <p class="font-heading-display text-2xl lg:text-3xl text-charcoal leading-snug mb-8" style="font-weight: 300;">
            {tagline}
          </p>
          <p class="text-text leading-relaxed mb-10">{standfirst}</p>
          <a href="/contact" class="btn-ghost btn-md">
            Talk to us about {name} <span class="arrow ml-2">&#8594;</span>
          </a>
        </div>

        <!-- Jump list. Replaced six numbered "highlights" that promised access. -->
        <div class="pt-0 lg:pt-16" data-reveal="fade-up" data-reveal-delay="2">
          <p class="section-kicker mb-6">Where we go</p>
          <ul class="divide-y divide-charcoal/10 border-t border-charcoal/10">
            {regions.map((region) => (
              <li>
                <a href={`#${region.id}`} class="tap-target-inline group flex items-baseline justify-between gap-6 py-4">
                  <span class="font-heading text-lg text-charcoal group-hover:text-brass transition-colors duration-200">{region.name}</span>
                  <span class="text-text-muted text-xs tracking-[0.15em] uppercase shrink-0">{region.courses.length} courses</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!--
    Region bands.

    Course names are listed as geography — what is in this region — never in a
    sentence that promises a tee time. See the rule in src/data/destinations.ts.
  -->
  {regions.map((region, index) => (
    <section id={region.id} class="scroll-mt-24 section-padding" style={index % 2 === 0 ? 'background: var(--color-white, #fff)' : 'background: var(--color-stone)'}>
      <div class="content-wide px-6 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

          <div class={`lg:col-span-7 ${index % 2 === 0 ? '' : 'lg:order-2'}`} data-reveal="fade-up">
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={region.imageSrc}
                alt={region.name}
                class="w-full h-full object-cover scale-on-hover"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class={`lg:col-span-5 ${index % 2 === 0 ? '' : 'lg:order-1'}`} data-reveal="fade-up" data-reveal-delay="2">
            <h2 class="font-heading text-charcoal mb-4" style="font-size: clamp(1.75rem, 3vw, 2.25rem);">{region.name}</h2>
            <p class="text-text leading-relaxed mb-8">{region.character}</p>

            <p class="section-kicker mb-4">Courses in this region</p>
            <ul class="space-y-3">
              {region.courses.map((course) => (
                <li class="border-t border-charcoal/10 pt-3">
                  <p class="font-heading text-base text-charcoal">{course.name}</p>
                  <p class="text-text-muted text-sm mt-0.5">{course.location}</p>
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </section>
  ))}

  <!-- Itinerary Section -->
  <!-- TODO: Replace placeholder - generic seven-day itinerary needs real destination-specific CGT sample itinerary details. -->
  <section class="section-padding bg-stone">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <!-- Left: section intro -->
        <div data-reveal="fade-up">
          <p class="section-kicker mb-6">How It Works</p>
          <h2 class="font-heading text-charcoal mb-6" style="font-size: clamp(2rem, 4vw, var(--text-section));">
            A week in {name},<br />done right
          </h2>
          <p class="text-text leading-relaxed mb-8">
            Every tour we build is unique. This is a guide to what a typical week looks like — your itinerary will be crafted around your courses, your dates, and your pace.
          </p>
          <a href="/contact" class="btn-primary btn-md">
            Build Your Itinerary
          </a>
        </div>

        <!-- Right: timeline -->
        <div class="space-y-8" data-reveal="fade-up" data-reveal-delay="2">
          <div class="flex gap-6 items-start">
            <div>
              <div class="flex items-center gap-4 mb-3">
                <span class="w-8 h-px bg-brass flex-shrink-0"></span>
                <p class="section-kicker">Day 1</p>
              </div>
              <h3 class="font-heading text-lg text-charcoal mb-1">Arrival & Welcome</h3>
              <p class="text-text text-sm leading-relaxed">Private airport transfer, check-in to your accommodation, and a welcome briefing over dinner.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div>
              <div class="flex items-center gap-4 mb-3">
                <span class="w-8 h-px bg-brass flex-shrink-0"></span>
                <p class="section-kicker">Days 2–4</p>
              </div>
              <h3 class="font-heading text-lg text-charcoal mb-1">Championship Golf</h3>
              <p class="text-text text-sm leading-relaxed">Three rounds shaped around your preferred courses. Availability and any arrangements are confirmed with you before you commit.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div>
              <div class="flex items-center gap-4 mb-3">
                <span class="w-8 h-px bg-brass flex-shrink-0"></span>
                <p class="section-kicker">Day 5</p>
              </div>
              <h3 class="font-heading text-lg text-charcoal mb-1">Your Day</h3>
              <p class="text-text text-sm leading-relaxed">Optional rest, local exploration, a distillery visit, or one more round — your call.</p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div>
              <div class="flex items-center gap-4 mb-3">
                <span class="w-8 h-px bg-brass flex-shrink-0"></span>
                <p class="section-kicker">Days 6–7</p>
              </div>
              <h3 class="font-heading text-lg text-charcoal mb-1">Final Rounds & Farewell</h3>
              <p class="text-text text-sm leading-relaxed">Two more rounds at the courses you've been waiting for, farewell dinner, and airport transfer home.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-celtic-dark">
    <div class="content-narrow px-6 lg:px-12 text-center">
      <h2 class="font-heading-display text-3xl md:text-4xl text-white mb-4" style="font-weight: 300;">
        Ready to experience {name}?
      </h2>
      <p class="text-white/60 text-lg mb-10 max-w-xl mx-auto">
        Tell us your courses. We'll handle the rest.
      </p>
      <a href="/contact" class="btn-primary btn-lg btn-primary-inverted">
        Start Planning
      </a>
    </div>
  </section>
</Layout>
