---
/**
 * Shared template for a trip-type page.
 *
 * Image-led and short by design — Terry's direction is photography over copy,
 * and the site's job is to make someone want to phone, not to answer every
 * question first. Everything ends at /contact.
 */
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import CelticDivider from './CelticDivider.astro';
import { images, imageUrl } from '../data/images';
import { findTripType, tripTypes, tripTypeHref, PLANNING_NOTE } from '../data/trip-types';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const trip = findTripType(slug);
if (!trip) {
  throw new Error(`TripTypePage: no trip type with slug "${slug}" in trip-types.ts`);
}

const other = tripTypes.find((t) => t.slug !== trip.slug)!;
const paragraphs = trip.body.split('\n\n');
---

<Layout title={trip.seoTitle} description={trip.seoDescription}>
  <!-- TODO: Replace placeholder - hero is stock; slot is {trip.image} in src/data/images.ts. -->
  <Hero
    title={trip.name}
    subtitle={trip.promise}
    backgroundImage={imageUrl(images[trip.image], 1800, 80)}
    size="medium"
    ctaText=""
  />

  <section class="section-padding bg-cream">
    <div class="content-wide px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

        <div data-reveal="fade-up">
          <p class="section-kicker mb-6">{trip.kicker}</p>
          {paragraphs.map((para) => (
            <p class="text-text leading-relaxed mb-6">{para}</p>
          ))}
          <p class="font-heading-display text-2xl lg:text-3xl text-charcoal leading-snug mt-10" style="font-weight: 300;">
            {trip.forWho}
          </p>
        </div>

        <div data-reveal="fade-up" data-reveal-delay="2">
          <p class="section-kicker mb-6">What we take off you</p>
          <ul class="space-y-5">
            {trip.weHandle.map((item) => (
              <li class="flex gap-4 items-start border-t border-charcoal/10 pt-5">
                <span class="w-1.5 h-1.5 bg-brass rotate-45 shrink-0 mt-2" aria-hidden="true"></span>
                <span class="text-text leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Planning window. Terry: this is why the call happens now and not later. -->
  <section class="py-20 lg:py-24 bg-celtic-dark relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('/textures/topo-lines.svg'); background-size: 400px;"></div>
    <div class="content-narrow px-6 lg:px-12 relative text-center" data-reveal="fade-up">
      <p class="font-heading-display text-2xl md:text-3xl text-champagne leading-relaxed" style="font-weight: 300;">
        {PLANNING_NOTE}
      </p>
      <CelticDivider variant="simple" color="brass" width="narrow" class="my-8" />
      <a href="/contact" class="btn-primary btn-lg btn-primary-inverted">
        Start the conversation
      </a>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="content-narrow px-6 lg:px-12 text-center" data-reveal="fade-up">
      <p class="section-kicker mb-4">The other way</p>
      <h2 class="font-heading text-charcoal mb-4" style="font-size: clamp(1.75rem, 3vw, 2.25rem);">{other.name}</h2>
      <p class="text-text leading-relaxed mb-8 max-w-xl mx-auto">{other.promise}</p>
      <a href={tripTypeHref(other)} class="btn-ghost btn-md">
        {other.name} <span class="arrow ml-2">&#8594;</span>
      </a>
    </div>
  </section>
</Layout>
