# Launch gates — both must be cleared to take the site public.
# COMING_SOON: exactly the string 'true' serves the holding page for every route.
# Any other value (including unset) means off.
COMING_SOON=false
# SITE_PASSWORD: any non-empty value puts the whole site behind a password.
# Delete or blank it to go public. Use ASCII only.
# Site password for authentication
SITE_PASSWORD=

# Sanity CMS
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Site contact & social (public)
PUBLIC_SITE_URL=
PUBLIC_SITE_EMAIL=
PUBLIC_SITE_OG_IMAGE=
PUBLIC_SITE_PHONE=
PUBLIC_SITE_ADDRESS_LINE1=
PUBLIC_SITE_ADDRESS_LINE2=
PUBLIC_SITE_CITY=
PUBLIC_SITE_REGION=
PUBLIC_SITE_POSTAL=
PUBLIC_SITE_COUNTRY=
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_X=
PUBLIC_SOCIAL_LINKEDIN=

# Headline claims — leave blank until Terry confirms real figures.
# Nothing renders unless PUBLIC_STATS_VERIFIED=true.
PUBLIC_STATS_VERIFIED=false
PUBLIC_STAT_HAPPY_GOLFERS=
PUBLIC_STAT_AVERAGE_RATING=
PUBLIC_STAT_TOURS_DELIVERED=
PUBLIC_STAT_YEARS_EXPERIENCE=
PUBLIC_STAT_COUNTRIES=

# Contact enquiries
RESEND_API_KEY=
NOTIFICATION_EMAIL=
ENQUIRY_FROM_EMAIL=

# Contact abuse protection. Set both values in Vercel Production after creating
# a Turnstile widget for the live domain; the server verifies challenges only
# when TURNSTILE_SECRET_KEY is present.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Licensed operator disclosure. "Centre Holidays" is the name registered to sell
# travel in Ontario and renders on every page regardless of these values.
# The TICO registration number renders only once this holds the real one —
# an invented registration number is worse than none.
PUBLIC_TICO_REGISTRATION=

# Set to 'true' only once Terry confirms which courses CGT can actually secure
# tee times at. Course names render as regional character either way; this gates
# any wording that promises access. See tasks/content-needed.md §3.
PUBLIC_COURSE_ACCESS_VERIFIED=false

# Enquiry routing. Booking questions go to Celtic's booking contact; general
# questions go to Terry. When GENERAL_EMAIL is empty a general enquiry falls
# back to BOOKING_EMAIL rather than being dropped — the subject line says which
# kind it is, so it can be forwarded. NOTIFICATION_EMAIL stays as a last resort.
BOOKING_EMAIL=celticgolftours@centreholidays.com
GENERAL_EMAIL=
